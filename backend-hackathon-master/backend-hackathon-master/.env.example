# Copy to .env for local development. On Render, set these in the service's Environment tab.

# SQLite by default (resets on free-tier restarts); any SQLAlchemy URL works, e.g. a free Neon/Supabase Postgres
DATABASE_URL=sqlite:///./sentinel.db

# Gemini key for failure diagnosis and the copilot (comma-separate several keys for quota fallback)
GOOGLE_API_KEY=
# Gemini model; if it gets retired the backend switches to the newest available Flash model
GEMINI_MODEL=gemini-flash-latest
# Grok (xAI) for sensor simulation; a local physics simulation is used when empty
XAI_API_KEY=

# Gmail SMTP alert emails (use an app password)
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=

# Twilio WhatsApp/SMS alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_TO=

DEBUG=true
# Comma-separated allowed origins ("*" = any), plus an optional regex such as https://.*\.vercel\.app
CORS_ORIGINS=*
CORS_ORIGIN_REGEX=

# How often the scheduler generates and analyses a reading per machine
SCHEDULER_INTERVAL_SECONDS=60
# Force every Nth reading to critical values to exercise the alert pipeline (0 = off)
DEMO_FORCE_CRITICAL_EVERY=0
SEED_DEMO_DATA=true
