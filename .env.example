# Copy to .env.local for local development. On Vercel, set these under Project -> Settings -> Environment Variables.

# Backend base URL (full URL or bare host). The WebSocket URL is derived from it (https -> wss).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional override if the WebSocket lives elsewhere
# NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Optional: lets the copilot chat stream straight from Gemini.
# Without it, chat is answered by the backend's /copilot/chat endpoint.
GOOGLE_GENERATIVE_AI_API_KEY=
